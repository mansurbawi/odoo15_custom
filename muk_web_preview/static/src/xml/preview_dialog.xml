<templates xml:space="preserve">

	<!-- Odoo 15 / Bootstrap 4 port -->
	<div t-name="PreviewDialog" class="modal o_preview_modal" tabindex="-1" data-backdrop="static" role="dialog" aria-hidden="true">
		<div class="modal-dialog modal-xl" role="document">
			<div class="modal-content">
				<header class="modal-header preview-header">
					<h4 class="modal-title preview-title text-truncate"><t t-esc="title"/></h4>
					<div class="preview-buttons ml-auto">
						<button type="button" class="preview-dialog-btn preview-print" title="Print"><i class="fa fa-print"/></button>
						<a class="preview-dialog-btn preview-download" title="Download" t-att-href="url"><i class="fa fa-download"/></a>
						<button type="button" class="preview-dialog-btn preview-maximize" title="Maximize"><i class="fa fa-expand"/></button>
						<button type="button" class="preview-dialog-btn preview-minimize" title="Minimize"><i class="fa fa-compress"/></button>
						<button type="button" class="preview-dialog-btn preview-close" data-dismiss="modal" title="Close"><i class="fa fa-times"/></button>
					</div>
				</header>
				<main class="modal-body preview-body"/>
				<footer class="modal-footer">
					<button type="button" class="btn btn-primary" data-dismiss="modal">Ok</button>
				</footer>
			</div>
		</div>
	</div>

</templates>
